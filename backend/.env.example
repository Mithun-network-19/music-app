# ============================================
# AuraSound Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# Server port (Render sets this automatically)
PORT=5000

# MongoDB Atlas Connection URI
# Get yours from: https://cloud.mongodb.com → Connect → Connect your application
# Replace <username>, <password>, and <cluster> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/music_db?retryWrites=true&w=majority

# Optional: Node environment (production / development)
NODE_ENV=development
